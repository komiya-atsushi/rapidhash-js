{
  "name": "benchmark",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "compile": "tsc",
    "prebench": "npm run compile",
    "bench": "npm run bench:string && npm run bench:bytes",
