{
  "name": "rapidhash-js",
  "version": "3.0.0",
  "description": "A TypeScript implementation of Rapidhash",
  "keywords": [
    "hash",
    "rapidhash"
  ],
  "author": {
    "name": "KOMIYA Atsushi",
    "url": "https://github.com/komiya-atsushi"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/komiya-atsushi/rapidhash-js.git"
  },
  "bugs": {
    "url": "https://github.com/komiya-atsushi/rapidhash-js/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "test": "npm run test:jest && npm run test:attw",
    "test:jest": "vitest --run",
    "test:attw": "attw --profile node16 --format table-flipped --pack .",
    "pretest": "npm run build"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "default": "./lib/index.js"
    },
    "./v1.0": {
      "import": "./lib/v1.0/index.mjs",
      "default": "./lib/v1.0/index.js"
    },
    "./v2.0": {
      "import": "./lib/v2.0/index.mjs",
      "default": "./lib/v2.0/index.js"
    },
    "./v2.2": {
      "import": "./lib/v2.2/index.mjs",
      "default": "./lib/v2.2/index.js"
    },
    "./v3.0": {
      "import": "./lib/v3.0/index.mjs",
      "default": "./lib/v3.0/index.js"
    }
  },
  "files": [
    "lib/**/*.*",
    "CHANGELOG.md"
  ]
}
